{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth.uid === $uid || root.child('users/' + auth.uid + '/role').val() === 'boss'",
        ".write": "auth.uid === $uid || root.child('users/' + auth.uid + '/role').val() === 'boss'",
        ".validate": "newData.child('role').isString() && (!newData.child('name').exists() || newData.child('name').isString())"
      }
    },

    "projects": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["status", "name", "createdAt"],
      "$pid": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users/' + auth.uid + '/role').val() === 'boss' || root.child('users/' + auth.uid + '/projects').hasChild($pid) || root.child('users/' + auth.uid + '/bossOf').hasChild($pid))",
        ".validate": "newData.hasChildren(['name', 'status', 'createdAt']) || !data.exists()",

        "billings": { ".indexOn": ["seq", "status"] },
        "changeOrders": { ".indexOn": ["seq", "status"] },
        "purchaseOrders": { ".indexOn": ["seq", "status"] },
        "ledger": { ".indexOn": ["poId", "status"] },
        "attendanceHistory": { ".indexOn": "savedAt" },
        "payrollLogs": { ".indexOn": "savedAt" },
        "siteLogs": { ".indexOn": "savedAt" }
      }
    },

    "suppliers": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'boss'",
      ".indexOn": "name"
    },

    "auditLogs": {
      ".read": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'boss'",
      ".write": "auth != null && newData.hasChildren(['action', 'entityType', 'userId', 'userName', 'timestamp'])",
      ".indexOn": "timestamp"
    },

    "notifications": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth != null",
        ".indexOn": ["read", "createdAt"]
      }
    },

    "complianceAlertsSent": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "sessions": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": false
      }
    }
  }
}
