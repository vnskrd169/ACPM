{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth.uid === $uid || root.child('users/' + auth.uid + '/role').val() === 'boss'",
        ".write": "root.child('users/' + auth.uid + '/role').val() === 'boss' || (auth.uid === $uid && !data.exists() && newData.child('role').val() === 'apm' && newData.child('status').val() === 'pending' && newData.child('projects').numChildren() === 0 && newData.child('bossOf').numChildren() === 0)",
        ".validate": "!newData.exists() || (( !newData.child('name').exists() || (newData.child('name').isString() && newData.child('name').val().length <= 100) ) && ( !newData.child('position').exists() || (newData.child('position').isString() && newData.child('position').val().length <= 100) ) && ( !newData.child('status').exists() || (newData.child('status').isString() && newData.child('status').val().matches(/^(pending|active|disabled)$/)) ) && ( !newData.child('role').exists() || (newData.child('role').isString() && newData.child('role').val().matches(/^(boss|apm)$/)) ))"
      }
    },

    "projects": {
      ".read": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'boss'",
      ".indexOn": ["status", "name", "createdAt"],
      "$pid": {
        ".read": "auth != null && (root.child('users/' + auth.uid + '/role').val() === 'boss' || root.child('users/' + auth.uid + '/projects').hasChild($pid) || root.child('users/' + auth.uid + '/bossOf').hasChild($pid))",
        ".write": "auth != null && (root.child('users/' + auth.uid + '/role').val() === 'boss' || (newData.exists() && data.child('status').val() === 'active' && newData.child('status').val() === data.child('status').val() && (root.child('users/' + auth.uid + '/projects').hasChild($pid) || root.child('users/' + auth.uid + '/bossOf').hasChild($pid))))",
        ".validate": "newData.hasChildren(['name', 'status', 'createdAt']) || !data.exists()",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" 
        },
        "status": { 
          ".validate": "newData.isString() && newData.val().matches(/^(active|completed|archived)$/)",
          ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'boss'"
        },
        "laborBudget": { ".validate": "newData.isNumber() && newData.val() >= 0" 
        },
        "materialBudget": { ".validate": "newData.isNumber() && newData.val() >= 0" 
        },
        "laborSpent": { ".validate": "newData.isNumber() && newData.val() >= 0" 
        },
        "materialSpent": { ".validate": "newData.isNumber() && newData.val() >= 0" 
        },
        "laborBudgetDelta": { ".validate": "newData.isNumber()" 
        },
        "materialBudgetDelta": { ".validate": "newData.isNumber()" 
        },
        "createdAt": { 
          ".validate": "newData.isNumber()" 
        },
        "lifecycleRequests": {
          ".write": "auth != null && newData.exists() && (root.child('users/' + auth.uid + '/role').val() === 'boss' || root.child('users/' + auth.uid + '/projects').hasChild($pid) || root.child('users/' + auth.uid + '/bossOf').hasChild($pid))"
        },
        "billingConfig": { ".indexOn": ["nextBillingNo", "nextCollectionNo", "nextAdjustmentNo"] 
        },
        "billings": { ".indexOn": ["seq", "billingNo", "type", "status", "date", "dueDate", "createdAt"] 
        },
        "collections": { ".indexOn": ["collectionNo", "billingId", "date", "status", "createdAt", "referenceNo"] 
        },
        "billingAdjustments": { ".indexOn": ["adjustmentNo", "billingId", "type", "status", "date", "createdAt"] 
        },
        "billingAllocations": {
          ".indexOn": ["billingId", "collectionId", "status", "createdAt", "allocationType"],
          "$allocationId": {
            ".validate": "newData.hasChildren(['collectionId', 'billingId', 'amount', 'status', 'createdAt', 'createdBy'])"
          }
        },
        "retentionLedger": {
          ".indexOn": ["billingId", "collectionId", "type", "status", "date", "createdAt"],
          "$retentionId": {
            ".validate": "newData.hasChildren(['billingId', 'type', 'amount', 'status', 'createdAt', 'createdBy'])"
          }
        },
        "billingEvents": {
          ".indexOn": ["type", "billingId", "collectionId", "date", "createdAt", "status"],
          "$eventId": {
            ".validate": "newData.hasChildren(['type', 'createdAt', 'createdBy'])"
          }
        },
        "billingOutputs": { ".indexOn": ["type", "status", "billingId", "outputNo", "generatedAt"] 
        },
        "billingRollups": { ".indexOn": ["lastUpdatedAt"] 
        },
        "changeOrders": { ".indexOn": ["seq", "status"] 
        },
        "purchaseRequests": { ".indexOn": ["requestNo", "status", "requestedAt", "neededBy"] 
        },
        "purchaseOrders": { ".indexOn": ["seq", "poNo", "status", "supplierId", "createdAt", "date", "deliveryStatus"] 
        },
        "deliveries": { ".indexOn": ["poId", "deliveryDate", "receivedAt", "status", "supplierId"] 
        },
        "inventory": { ".indexOn": ["itemKey", "description", "qtyOnHand", "lastMovementAt"] 
        },
        "materialMovements": { 
          ".indexOn": ["type", "date", "createdAt", "itemKey", "poId", "deliveryId", "issueId", "supplierId"],
          "$movementId": {
            ".validate": "newData.hasChildren(['type', 'createdAt', 'createdBy'])"
          }
        },
        "materialIssuances": { ".indexOn": ["issueNo", "date", "createdAt", "issuedTo", "scope", "status"] 
        },
        "ledger": { ".indexOn": ["poId", "poItemId", "status", "supplierId", "date", "createdAt"] 
        },
        "trades": { ".indexOn": ["name", "foremanName"]
        },
        "workers": { ".indexOn": ["name", "trade", "active", "addedAt"]
        },
        "attendance": {
          "$workerId": { ".indexOn": ["weekKey", "date"]
          }
        },
        "advances": {
          "$workerId": { ".indexOn": ["weekKey", "date", "deducted", "trade"]
          }
        },
        "attendanceHistory": { ".indexOn": ["savedAt", "weekKey"]
        },
        "payrollLogs": { ".indexOn": ["savedAt", "weekKey"]
        },
        "siteLogs": { ".indexOn": "savedAt" 
        }
      }
    },

    "suppliers": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'boss'",
      ".indexOn": ["name", "specialty", "updatedAt"]
    },

    "auditLogs": {
      ".read": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'boss'",
      ".indexOn": "timestamp",
      "$logId": {
        ".write": "auth != null && newData.hasChildren(['action', 'entityType', 'userId', 'userName', 'timestamp']) && newData.child('action').isString() && newData.child('entityType').isString() && newData.child('userId').val() === auth.uid && newData.child('userName').isString() && newData.child('timestamp').isNumber()"
      }
    },

    "notifications": {
      ".read": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'boss'",
      "$uid": {
        ".read": "auth.uid === $uid || root.child('users/' + auth.uid + '/role').val() === 'boss'",
        ".indexOn": ["read", "createdAt"],
        "$nid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users/' + auth.uid + '/role').val() === 'boss' || (newData.exists() && newData.child('from').val() === auth.uid && newData.child('projectId').isString() && (root.child('users/' + auth.uid + '/projects').hasChild(newData.child('projectId').val()) || root.child('users/' + auth.uid + '/bossOf').hasChild(newData.child('projectId').val())) && (root.child('users/' + $uid + '/projects').hasChild(newData.child('projectId').val()) || root.child('users/' + $uid + '/role').val() === 'boss')))",
          ".validate": "!newData.exists() || (newData.hasChildren(['type', 'message', 'read', 'createdAt', 'from']) && newData.child('type').isString() && newData.child('message').isString() && newData.child('message').val().length <= 500 && newData.child('read').isBoolean() && newData.child('createdAt').isNumber() && newData.child('from').isString())"
        }
      }
    },

    "complianceAlertsSent": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'boss'"
    },

    "sessions": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": false
      }
    }
  }
}
